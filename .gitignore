# Data addons built on the developer's machine from local reference data.
addon/Polestar_Codex/
addon/Polestar_QuestDB/
addon/Polestar_Travel/

# Local data: game client tables, downloaded sources and their builds.
data/sources/
data/forever/
data/sim/
data/bench/
data/play/
data/local/
data/recordings/*
!data/recordings/.gitkeep

# Build output and drafts.
dist/
guides/drafts/
*.log

# Tooling.
# No trailing slash: a node_modules symlink (a worktree borrowing the clone's) is ignored too.
node_modules
.ref/

# The bug bot's secrets on the server.
tools/discord-bot/.env

# Personal agent instructions stay out of commits. This fork tracks a root
# CLAUDE.md of one line, @AGENTS.md, so Claude Code still reads AGENTS.md.
/CLAUDE.local.md
/.claude/CLAUDE.md

# forge data publish --zip writes the release zip beside forever-db/; never committed
/forever-db-*.zip
